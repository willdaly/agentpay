{
  "name": "agentpay",
  "version": "0.1.0",
  "description": "Policy-governed on-chain control plane for autonomous AI agent payments (testnet only).",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "coverage:check": "rm -rf coverage coverage.json && hardhat coverage && node scripts/check-coverage.js",
    "gas": "REPORT_GAS=true hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "slither": "slither . --config-file slither.config.json",
    "clean": "hardhat clean",
    "sizes": "hardhat compile && node scripts/check-sizes.js",
    "audit": "npm run lint && npm run coverage:check && npm run sizes && npm run slither"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.28.6",
    "solhint": "^6.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
