# AgentPay environment — copy to .env and fill in. .env is gitignored; NEVER commit it.
# Deployment uses a DEDICATED THROWAWAY key funded only with testnet ETH/LINK.

# --- RPC endpoints (testnets only) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Deployer key (throwaway, testnet funds only) ---
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# --- Block explorer API keys (contract verification) ---
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_KEY

# --- Gas reporter (optional) ---
COINMARKETCAP_API_KEY=
REPORT_GAS=false

# --- Agent client (agent/) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
