# AgentPay environment — copy to .env and fill in. .env is gitignored; NEVER commit it.
# Deployment uses a DEDICATED THROWAWAY key funded only with testnet ETH/LINK.
#
# Nothing here is required for local development: `npm test` and the local demo
# (hardhat node + localhost) run with this file absent entirely.

# =============================================================================
# Agent client (agent/) — the only value you need for a local LLM-driven demo
# =============================================================================

# Enables real model decisions in `agent quote`. Without it the CLI falls back to
# a deterministic "cheapest service" pick, clearly labelled (heuristic).
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY

# Home chain the agent operates on: localhost | sepolia
AGENTPAY_NETWORK=localhost

# Also read the service catalog from this chain (cross-chain marketplace view).
# Leave empty for a single-chain demo.
AGENTPAY_REMOTE_NETWORK=

# The agent wallet to drive. Leave empty to use the one the demo script creates
# (written to deployments/<network>.agent.json).
AGENT_WALLET_ADDRESS=

# The agent OPERATOR key — the key that calls spend(). Distinct from the wallet's
# owner/admin: a compromised operator key cannot raise its own limits.
# On a local node this is optional (the CLI signs as the unlocked operator account).
AGENT_PRIVATE_KEY=

# provider-sim endpoint, so a paid-for service is actually collected.
PROVIDER_SIM_URL=http://127.0.0.1:8787
PROVIDER_SIM_PORT=8787

# =============================================================================
# Testnet deploys (not needed for local development)
# =============================================================================

# --- RPC endpoints (testnets only) ---
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Deployer key (throwaway, testnet funds only) ---
DEPLOYER_PRIVATE_KEY=

# --- Block explorer API keys (contract verification) ---
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# --- Gas reporter (optional) ---
COINMARKETCAP_API_KEY=
REPORT_GAS=false
